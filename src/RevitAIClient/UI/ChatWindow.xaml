<Window x:Class="RevitAIClient.UI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit AI Assistant" Height="600" Width="400"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Revit AI Assistant" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="API Key:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Height="25"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Endpoint:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="EndpointBox" Grid.Column="1" Height="25" Text="https://api.deepseek.com/chat/completions" ToolTip="API Endpoint (OpenAI compatible)"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="ModelBox" Grid.Column="1" Height="25" Text="deepseek-flash"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="UseThinkingCheck" Content="Thinking" Grid.Column="0" VerticalAlignment="Center" IsChecked="False"/>
                <TextBlock Text="Effort:" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <ComboBox x:Name="EffortCombo" Grid.Column="3" Height="25" SelectedIndex="2">
                    <ComboBoxItem Content="low"/>
                    <ComboBoxItem Content="medium"/>
                    <ComboBoxItem Content="high"/>
                </ComboBox>
            </Grid>
        </StackPanel>
        
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatHistoryPanel"/>
        </ScrollViewer>
        
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Height="50" Margin="0,0,5,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5,5"/>
            <Button Grid.Column="1" Content="Send" Width="60" Height="50" Margin="0,0,5,0" Click="Send_Click"/>
            <Button Grid.Column="2" Content="Test API" Width="60" Height="50" Click="TestApi_Click" ToolTip="Test Revit API access from background thread"/>
        </Grid>
    </Grid>
</Window>