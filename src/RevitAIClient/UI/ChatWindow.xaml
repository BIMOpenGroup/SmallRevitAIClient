<Window x:Class="RevitAIClient.UI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit AI Assistant" Height="500" Width="350"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Revit AI Assistant" FontWeight="Bold" FontSize="16" Margin="10"/>
        
        <ScrollViewer Grid.Row="1" Margin="10,0">
            <TextBlock Text="Чат пока пуст..." Foreground="Gray" FontStyle="Italic"/>
        </ScrollViewer>
        
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Height="30" Margin="0,0,5,0" VerticalContentAlignment="Center" Padding="5,0"/>
            <Button Grid.Column="1" Content="Send" Width="60" Height="30"/>
        </Grid>
    </Grid>
</Window>